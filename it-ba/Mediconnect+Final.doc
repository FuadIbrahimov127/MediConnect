nceTd">
<p local-id=3D"763cfa01d147">Randevu "pending" statusu il=C9=99 yarad=C4=B1=
l=C4=B1r, h=C9=99kim=C9=99 t=C9=99sdiq sor=C4=9Fusu g=C3=B6nd=C9=99rilir. P=
asient=C9=99 "H=C9=99kimin t=C9=99sdiqi g=C3=B6zl=C9=99nilir" mesaj=C4=B1 g=
=C3=B6st=C9=99rilir.</p>
