nceTd">
<p local-id=3D"312fcccb6aa2">Slot se=C3=A7ildikd=C9=99 <strong>soft lock</s=
trong> (10 d=C9=99qiq=C9=99) t=C9=99tbiq olunur ki, iki pasient eyni vaxt=
=C4=B1 tuta bilm=C9=99sin. Randevu t=C9=99sdiql=C9=99ndikd=C9=99 slot daimi=
 bloklan=C4=B1r v=C9=99 unikal <strong>booking reference</strong> yarad=C4=
=B1l=C4=B1r =E2=80=94 pasient bunu klinikada t=C9=99qdim edir.</p>
</td>
</tr>
<tr data-local-id=3D"d7936cb1-c2b5-4474-9b07-f60d65c7564f">
<td data-highlight-colour=3D"#f1f1f1" data-local-id=3D"e051c31a-d57c-4e64-9=
4f7-19ed57d3bfaf" class=3D"confluenceTd">
<p local-id=3D"3ecd84ef4b8c">Successful user flow</p>
</td>
<td data-local-id=3D"30ec801b-1ba8-42fb-bcb6-56767373c8a4" class=3D"conflue=
nceTd">
<ol start=3D"1" local-id=3D"75733617-9f61-4742-9444-85745e5a5504">
<li local-id=3D"f8820ca4-ea04-4007-8d0a-a9b3b181f8eb">
<p local-id=3D"71552c5fef84">Pasient h=C9=99kim s=C9=99hif=C9=99sind=C9=99 =
"Randevu al" d=C3=BCym=C9=99sini bas=C4=B1r</p>
</li>
<li local-id=3D"d202b924-1218-43fd-809b-7f7464b41607">
<p local-id=3D"f9e9fde42110">Sistem autentifikasiyan=C4=B1 yoxlay=C4=B1r</p=
>
</li>
<li local-id=3D"853cbd00-76eb-48f1-a5ab-1787deff2cff">
<p local-id=3D"bde074a28421">Sistem <code>/booking/{doctorId}</code> s=C9=
=99hif=C9=99sini a=C3=A7=C4=B1r</p>
</li>
<li local-id=3D"9bd54147-0cc0-4f12-9c4d-540e6899c42d">
<p local-id=3D"5e8c6c36a3b7">Sistem h=C9=99kim bir ne=C3=A7=C9=99 klinikada=
 i=C5=9Fl=C9=99yirs=C9=99 klinika se=C3=A7imini g=C3=B6st=C9=99rir</p>
</li>
<li local-id=3D"ba161b84-b765-449f-ac7d-9bd2b6c97214">
<p local-id=3D"cf2846ee048c">Pasient klinikan=C4=B1 se=C3=A7ir</p>
</li>
<li local-id=3D"ca10bd60-5055-4408-b06e-f146f6511f81">
<p local-id=3D"c5da01f4a35e">Sistem se=C3=A7ilmi=C5=9F klinika =C3=BCzr=C9=
=99 xidm=C9=99t siyah=C4=B1s=C4=B1n=C4=B1 g=C3=B6st=C9=99rir</p>
</li>
<li local-id=3D"819ece9b-55e8-438f-abdf-f9d057803ff0">
<p local-id=3D"2c1dcf12835a">Pasient xidm=C9=99t n=C3=B6v=C3=BCn=C3=BC se=
=C3=A7ir (ilkin m=C3=BCayin=C9=99, t=C9=99krar m=C3=BCayin=C9=99, konsultas=
iya)</p>
</li>
<li local-id=3D"1bf18d4f-3e82-4002-9b36-9dc6235c2192">
<p local-id=3D"f9e3d507e9df">Sistem se=C3=A7ilmi=C5=9F xidm=C9=99tin m=C3=
=BCdd=C9=99tin=C9=99 uy=C4=9Fun bo=C5=9F slotlar=C4=B1 hesablay=C4=B1r</p>
</li>
<li local-id=3D"41bd586b-501b-41fe-b9e8-425ca799151a">
<p local-id=3D"3defe6769373">Sistem t=C9=99qvimi g=C3=B6st=C9=99rir: bo=C5=
=9F g=C3=BCnl=C9=99r aktiv, dolu/ba=C4=9Fl=C4=B1 g=C3=BCnl=C9=99r deaktiv</=
p>
</li>
<li local-id=3D"b81a4525-7442-481e-b546-aa5586aac24b">
<p local-id=3D"557f2eefb7d4">Pasient tarixi se=C3=A7ir</p>
</li>
<li local-id=3D"63f5b558-3d2e-425f-88be-c3aeebd87f55">
<p local-id=3D"38ff2fb7d597">Sistem h=C9=99min g=C3=BCn =C3=BC=C3=A7=C3=BCn=
 bo=C5=9F saat slotlar=C4=B1n=C4=B1 g=C3=B6st=C9=99rir</p>
</li>
<li local-id=3D"be32564c-09a9-4051-bd9d-cebff3764fc4">
<p local-id=3D"0121cbe5b7a5">Pasient saat slotunu se=C3=A7ir</p>
</li>
<li local-id=3D"fbace81b-c81f-4f1c-b42a-0e13b7e7180a">
<p local-id=3D"b2a4766d486d">Sistem slotu <strong>soft lock</strong> edir (=
10 d=C9=99qiq=C9=99)</p>
</li>
<li local-id=3D"c66a4495-010a-4bd7-8a39-882d4ec9195f">
<p local-id=3D"6884e68d798a">Sistem geri say=C4=B1m taymerini g=C3=B6st=C9=
=99rir</p>
</li>
<li local-id=3D"2c2e43e2-dc8d-4449-951d-d1d8d8c76e73">
<p local-id=3D"8a6f26aca2cb">Pasient =C5=9Fikay=C9=99t/qeyd sah=C9=99sini d=
oldurur (optional)</p>
</li>
<li local-id=3D"17f7de58-b98e-4d10-aca7-4d9e1c4448e0">
<p local-id=3D"d2039ab55b4f">Pasient tibbi s=C9=99n=C9=99d =C9=99lav=C9=99 =
etm=C9=99k ist=C9=99yirs=C9=99 se=C3=A7ir (optional)</p>
</li>
<li local-id=3D"4b1ce125-18f5-4e43-a065-b246f5bca04f">
<p local-id=3D"8865fbd0c50a">Sistem randevu x=C3=BClas=C9=99sini g=C3=B6st=
=C9=99rir: h=C9=99kim, klinika, =C3=BCnvan, tarix, saat, xidm=C9=99t</p>
</li>
<li local-id=3D"b5892b44-065c-4e10-8e83-59dfffa0e051">
<p local-id=3D"b293664767b6">Sistem "M=C3=BCayin=C9=99nin d=C9=99y=C9=99ri =
klinikada m=C3=BC=C9=99yy=C9=99n edilir" qeydini g=C3=B6st=C9=99rir</p>
</li>
<li local-id=3D"9706fdc2-307e-426b-bc7f-056b0f1ee1d6">
<p local-id=3D"47ad3da679c3">Pasient "Randevunu t=C9=99sdiql=C9=99" d=C3=BC=
ym=C9=99sini bas=C4=B1r</p>
</li>
<li local-id=3D"19e13b5b-f285-4520-aa0b-06220d9cfb1d">
<p local-id=3D"433cc64971a5">Sistem slot statusunu yenid=C9=99n yoxlay=C4=
=B1r</p>
</li>
<li local-id=3D"605b63ca-6eaf-49d2-9f90-93ab59b4e59d">
<p local-id=3D"4cc06986bdec">Sistem biznes qaydalar=C4=B1n=C4=B1 yoxlay=C4=
=B1r (eyni g=C3=BCnd=C9=99 t=C9=99krar randevu, no-show limiti)</p>
</li>
<li local-id=3D"e1f4f502-7e65-409d-b218-e9772bd0e0c5">
<p local-id=3D"2c0676438b6f">Sistem randevunu yarad=C4=B1r v=C9=99 unikal b=
ooking reference t=C9=99yin edir</p>
</li>
<li local-id=3D"821c205c-ea7d-472e-8079-28be64b2b77f">
<p local-id=3D"1796ca52aaad">Sistem slot statusunu "booked" edir</p>
</li>
<li local-id=3D"94a44056-ad68-4b22-9e20-742473ced109">
<p local-id=3D"e7123513dfa6">Sistem h=C9=99kimin t=C9=99sdiq rejimin=C9=99 =
g=C3=B6r=C9=99 status t=C9=99yin edir: avtomatik =E2=86=92 "confirmed", man=
ual =E2=86=92 "pending"</p>
</li>
<li local-id=3D"49600336-1fb5-4b91-b0e4-a5b2dd47cfa5">
<p local-id=3D"1bcca6582c64">Sistem =C9=99lav=C9=99 edilmi=C5=9F s=C9=99n=
=C9=99dl=C9=99r =C3=BC=C3=A7=C3=BCn h=C9=99kim=C9=99 avtomatik giri=C5=9F i=
caz=C9=99si yarad=C4=B1r</p>
</li>
<li local-id=3D"1367591e-3fe6-44a7-a1eb-347bd8247836">
<p local-id=3D"f925438f33bc">Sistem pasient=C9=99 t=C9=99sdiq bildiri=C5=9F=
i g=C3=B6nd=C9=99rir</p>
</li>
<li local-id=3D"e870d46c-e32a-4537-8888-ec2a505432fc">
<p local-id=3D"0773fde82af4">Sistem h=C9=99kim=C9=99 yeni randevu bildiri=
=C5=9Fi g=C3=B6nd=C9=99rir</p>
</li>
<li local-id=3D"80325da1-4b94-4667-ad94-93061df955f4">
<p local-id=3D"8cf7161fa633">Sistem xat=C4=B1rlatmalar=C4=B1 planla=C5=9Fd=
=C4=B1r=C4=B1r (24 saat v=C9=99 2 saat =C9=99vv=C9=99l)</p>
</li>
<li local-id=3D"3f1da8db-1b7a-4862-bfa9-0155cbca028c">
<p local-id=3D"f2d3e78d3e76">Sistem pasienti randevu detallar=C4=B1 s=C9=99=
hif=C9=99sin=C9=99 y=C3=B6nl=C9=99ndirir</p>
</li>
</ol>
</td>
</tr>
<tr data-local-id=3D"867ae60f-df37-4295-bbaf-2e4d6bf68019">
