<h1 local-id=3D"4c6e2c4867cc" id=3D"MediconnectFinal-=C3=9Cmumim=C9=99lumat=
">=C3=9Cmumi m=C9=99lumat</h1>
<p local-id=3D"de55313601f8"><strong>MediConnect </strong>- pasientl=C9=99r=
in h=C9=99kim axtar=C4=B1=C5=9F=C4=B1, randevu planla=C5=9Fd=C4=B1rmas=C4=
=B1, tibbi s=C9=99n=C9=99dl=C9=99rin idar=C9=99si v=C9=99 elektron reseptl=
=C9=99rin al=C4=B1nmas=C4=B1 prosesl=C9=99rini vahid r=C9=99q=C9=99msal pla=
tformada birl=C9=99=C5=9Fdir=C9=99n s=C9=99hiyy=C9=99 h=C9=99llidir. Haz=C4=
=B1rda Az=C9=99rbaycanda tibbi randevu prosesi =C9=99sas=C9=99n telefon z=
=C9=99ngl=C9=99ri v=C9=99 resepsiya n=C3=B6vb=C9=99l=C9=99ri vasit=C9=99sil=
=C9=99 h=C9=99yata ke=C3=A7irilir ki, bu da h=C9=99m pasientl=C9=99r, h=C9=
=99m d=C9=99 klinikalar =C3=BC=C3=A7=C3=BCn vaxt itkisin=C9=99 v=C9=99 s=C9=
=99m=C9=99r=C9=99sizliy=C9=99 s=C9=99b=C9=99b olur. Pasientl=C9=99rin tibbi=
 tarix=C3=A7=C9=99si, analiz n=C9=99tic=C9=99l=C9=99ri v=C9=99 reseptl=C9=
=99ri m=C3=BCxt=C9=99lif klinika v=C9=99 laboratoriyalarda da=C4=9F=C4=B1n=
=C4=B1q =C5=9F=C9=99kild=C9=99 saxlan=C4=B1l=C4=B1r, bu is=C9=99 m=C3=BCali=
c=C9=99nin davaml=C4=B1l=C4=B1=C4=9F=C4=B1n=C4=B1 =C3=A7=C9=99tinl=C9=99=C5=
=9Fdirir. MediConnect bu probleml=C9=99ri aradan qald=C4=B1rmaq =C3=BC=C3=
=A7=C3=BCn pasientl=C9=99r=C9=99 online randevu alma, tibbi s=C9=99n=C9=99d=
l=C9=99rini bir yerd=C9=99n idar=C9=99 etm=C9=99 v=C9=99 e-reseptl=C9=99rin=
i r=C9=99q=C9=99msal formada alma imkan=C4=B1 yarad=C4=B1r. Platforma eyni =
zamanda h=C9=99kim v=C9=99 klinikalara randevu c=C9=99dv=C9=99li, pasient q=
eydl=C9=99ri v=C9=99 reseptl=C9=99rin idar=C9=99si =C3=BC=C3=A7=C3=BCn admi=
n panel t=C9=99qdim edir. <span style=3D"color: rgb(101,84,192);"><u>Layih=
=C9=99 veb platforma olaraq n=C9=99z=C9=99rd=C9=99 tutulub v=C9=99 g=C9=99l=
=C9=99c=C9=99kd=C9=99 mobil t=C9=99tbiq, telemedicine (video konsultasiya) =
v=C9=99 aptek inteqrasiyas=C4=B1 il=C9=99 geni=C5=9Fl=C9=99ndirilm=C9=99si =
planla=C5=9Fd=C4=B1r=C4=B1l=C4=B1r.</u></span></p>
<div class=3D"confluence-information-macro confluence-information-macro-inf=
ormation">
<span class=3D"aui-icon aui-icon-small aui-iconfont-info confluence-informa=
tion-macro-icon"></span>
<div class=3D"confluence-information-macro-body">
<p local-id=3D"53092f2685e9"><strong>=C3=96d=C9=99ni=C5=9F v=C9=99 qiym=C9=
=99t modeli:</strong> Platformada qiym=C9=99t g=C3=B6st=C9=99rilmir v=C9=99=
 online =C3=B6d=C9=99ni=C5=9F apar=C4=B1lm=C4=B1r. M=C3=BCayin=C9=99nin n=
=C3=B6v=C3=BC, =C5=9F=C9=99rtl=C9=99ri v=C9=99 d=C9=99y=C9=99ri klinikada, =
q=C9=99bul zaman=C4=B1 m=C3=BC=C9=99yy=C9=99n edilir. Platforma yaln=C4=B1z=
 randevunun planla=C5=9Fd=C4=B1r=C4=B1lmas=C4=B1n=C4=B1, tibbi s=C9=99n=C9=
=99dl=C9=99rin v=C9=99 reseptl=C9=99rin idar=C9=99sini t=C9=99min edir.</p>
</div>
</div>
